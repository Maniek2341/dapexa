# Copy to /var/www/dapexa/.env, set owner deploy and chmod 600.
# Empty secrets must be generated/filled locally; never commit the actual .env.
DJANGO_DEBUG=False
DJANGO_SECRET_KEY=
PUBLIC_DOMAIN=example.com
PANEL_DOMAIN=panel.example.com
DOMAIN_URL=https://panel.example.com
DJANGO_ALLOWED_HOSTS=example.com,panel.example.com,localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=https://example.com,https://panel.example.com
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
DB_ENGINE=django.db.backends.postgresql
DB_NAME=dapexa
DB_USER=dapexa
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=5432
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/1
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_START_MONTHLY=
STRIPE_PRICE_START_YEARLY=
STRIPE_PRICE_STANDARD_MONTHLY=
STRIPE_PRICE_STANDARD_YEARLY=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_YEARLY=
STRIPE_AMOUNT_START_MONTHLY=
STRIPE_AMOUNT_START_YEARLY=
STRIPE_AMOUNT_STANDARD_MONTHLY=
STRIPE_AMOUNT_STANDARD_YEARLY=
STRIPE_AMOUNT_PRO_MONTHLY=
STRIPE_AMOUNT_PRO_YEARLY=
EMAIL_USE_SSL=True
EMAIL_HOST=
EMAIL_PORT=465
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=
ORS_API_KEY=
GOOGLE_API_KEY=
# Set once and keep stable: feed URLs are encrypted with this key in PostgreSQL.
SUPPLIER_FEED_ENCRYPTION_KEY=replace-with-a-long-random-secret
